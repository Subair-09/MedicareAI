# MONGODB_URI: MongoDB connection URI (e.g., MongoDB Atlas or local instance)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# MONGODB_DB_NAME: Database name to use in MongoDB
MONGODB_DB_NAME=medicare_db

# CLOUDINARY_CLOUD_NAME: Your Cloudinary cloud name (e.g., dxyz123)
CLOUDINARY_CLOUD_NAME=

# CLOUDINARY_API_KEY: Your Cloudinary API Key
CLOUDINARY_API_KEY=

# CLOUDINARY_API_SECRET: Your Cloudinary API Secret
CLOUDINARY_API_SECRET=

# CLOUDINARY_FOLDER: Folder in Cloudinary to store images and clinical PDFs
CLOUDINARY_FOLDER=medicare_hospital

# GROQ_API_KEY: Required for Groq LLM API calls (https://console.groq.com)
# Used to power MediCare AI with openai/gpt-oss-120b and high-speed inference.
GROQ_API_KEY=

# GROQ_MODEL: Default Groq model to use (defaults to openai/gpt-oss-120b)
GROQ_MODEL="openai/gpt-oss-120b"

# GEMINI_API_KEY: Optional/legacy fallback for Gemini AI API calls.
GEMINI_API_KEY=

# ADMIN_EMAIL: Administrator email address for accessing the staff and administrative console
ADMIN_EMAIL=

# ADMIN_PASSWORD: Secure password for administrator console authentication
ADMIN_PASSWORD=

# ADMIN_NAME: Display name for the administrator in the management console (optional)
ADMIN_NAME=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: API key for Resend email delivery (https://resend.com)
# Used to send automated appointment booking, rescheduling, and cancellation emails to patients.
RESEND_API_KEY=

# RESEND_FROM_EMAIL: Sender email address (e.g. "MediCare Hospital <noreply@medicare.name.ng>")
RESEND_FROM_EMAIL="MediCare Hospital <noreply@medicare.name.ng>"

